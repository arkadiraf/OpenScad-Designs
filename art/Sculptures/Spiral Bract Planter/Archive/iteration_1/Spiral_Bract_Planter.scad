// Spiral Bract Planter - a 20 cm cachepot clad in overlapping bracts, like an artichoke, but set
// on a golden-angle spiral (137.5 deg per leaf) instead of rows, and with no two leaves alike.
//
// The body is a smooth turned pot (the envelope): cosine flanks from the bed to the belly and in
// again to a vertical collar at the rim. Every bract is a solid lying on the envelope: a height
// field h(u, t) over its own outline (u across, t from base to tip), drawn as one polyhedron whose
// underside sits `inset` mm inside the pot wall. Each leaf leans a few degrees the same way round,
// so the spiral swirls; the top leaves grow longer and rise above the rim as a crown.
//
// The leaf table is generated by Spiral_Bract_Planter_leaves.py (layout, a flat sheet of every leaf,
// and an unrolled map of the whole body) and written between the BEGIN/END LEAVES markers below.
// The leaf functions here mirror that script's: change them together.
//
// Printing without supports: a leaf's lower half fades into the body (h -> 0 at its lower edges)
// and is overlapped by the tips of the leaves below; the edge step only grows above the shoulder,
// where the edge faces up. Shoulders stay below the rim, so the crown blades only have upward edges.

/* [Output] */
part = "assembly"; // [assembly, body, none]
// Coarse leaf grids: for finding the shape
sketch = false;

/* [Pot] */
// Wall thickness of the pot under the leaves, mm
wall = 4;           // [3:0.5:6]
// Floor thickness, mm
floor_t = 4;        // [3:0.5:8]
// Drain hole diameter, mm (0 = none: a cachepot)
drain_d = 0;        // [0:1:20]
// Leaf underside, mm inside the envelope (must stay below `wall`)
inset = 2.5;

/* [Body] */
// keep in step with Spiral_Bract_Planter_leaves.py
R0 = 66;    // radius at the bed, mm
RB = 89;    // radius at the belly, mm
RT = 72;    // radius at the rim, mm
ZB = 78;    // belly height, mm
ZT = 165;   // rim height, mm

/* [Hidden] */
GM = sketch ? 10 : 26;      // rows along a leaf
GN = sketch ? 8 : 18;       // columns across
$fn = sketch ? 72 : 240;
rim_in = RT - wall;

