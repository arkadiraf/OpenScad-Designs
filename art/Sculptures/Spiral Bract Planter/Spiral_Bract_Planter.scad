// Spiral Bract Planter - a 20 cm planter clad in bracts set on a golden-angle spiral (137.5 deg per
// leaf), no two alike, bending open like a flower towards the top.
//
// The body is a smooth turned pot (the envelope): cosine flanks from the bed to the belly and in
// again to a vertical collar at the rim. Each leaf (Spiral_Bract_leaf.scad) is solid from inside the
// pot wall out to its face: iteration 1's dome, plus its own bend - flare, cup or trough, twist, tip
// curl - with a hollow lip along its upper edges, 2.5 mm thick at the edge. Each leaf leans a few
// degrees the same way round, so the spiral swirls; the top leaves grow longer, open furthest, and
// stand on the rim as a crown.
//
// The leaf table is generated by Spiral_Bract_Planter_leaves.py and written between the BEGIN/END
// LEAVES markers below. The script also scales each leaf's bend down until none of its surfaces
// hangs past 48 deg from vertical. The leaf functions mirror that script's: change them together.
//
// Printing without supports: a leaf's lower edges fade into the body and only its upper part bends
// open, the bend is budgeted per leaf, the leaves are solid (no air pockets under them), and near
// the rim their underside reaches into the wall so the crown stands on it. Underneath, a drain hole with radial
// channels lets water out into the saucer.

include <Spiral_Bract_leaf.scad>

/* [Output] */
part = "assembly"; // [assembly, body, none]
// Coarse leaf grids and no veins: for finding the shape
sketch = false;

/* [Pot] */
// Wall thickness of the pot under the leaves, mm
wall = 4;           // [3:0.5:6]
// Floor thickness, mm
floor_t = 5;        // [3:0.5:8]
// Drain hole diameter, mm (0 = none: a cachepot)
drain_d = 12;       // [0:1:20]
// Channels under the floor from the drain hole to the outside, so water runs into the saucer
channels = 3;       // [0:1:6]
channel_w = 5;      // mm
channel_d = 1.6;    // mm

/* [Leaves] */
// Leaf thickness at its free edges, mm (keep in step with EDGE_T in the script)
edge_t = 2.5;
// Veins on the leaves (keep in step with TEXTURE in the script)
texture_on = true;

/* [Body] */
// keep in step with Spiral_Bract_Planter_leaves.py
R0 = 66;    // radius at the bed, mm
RB = 89;    // radius at the belly, mm
RT = 72;    // radius at the rim, mm
ZB = 78;    // belly height, mm
ZT = 165;   // rim height, mm

/* [Hidden] */
texture = texture_on && !sketch;
GM = sketch ? 14 : texture ? 110 : 72;     // rows along a leaf (finer for the veins)
GN = sketch ? 10 : texture ? 52 : 36;      // columns across
$fn = sketch ? 72 : 240;
rim_in = RT - wall;

