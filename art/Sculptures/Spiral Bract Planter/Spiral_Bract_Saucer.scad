// END LEAVES

// ---------------------------------------------------------------- envelope
function R(z) = rf + wall + (z - floor_t) * tf;
function dR(z) = tf;
// near the rim the leaves' solid underside reaches into the wall, to 0.6 mm short of the inside,
// so the petals stand on the rim and the cavity cuts no leaf
function under_shift(z) = -(wall - 1.4) * ss(ZT - 6, ZT, z);

// ---------------------------------------------------------------- tray
module tray() rotate_extrude(convexity = 4) polygon([[0, 0], [R(0), 0], [R(ZT), ZT], [0, ZT]]);
// the inside, carried on up past the rim; it stays 0.6 mm clear of the petals
module cavity() rotate_extrude(convexity = 4)
    polygon([[0, floor_t], [rf, floor_t], [rf + (top - floor_t) * tf, top], [0, top]]);

module saucer() difference() {
    union() {
        tray();
        for (g = leaves) leaf(g);
    }
    cavity();
    translate([0, 0, -50]) cylinder(r = 200, h = 50);
}

// ---------------------------------------------------------------- summary
echo(str("Spiral bract saucer: ", len(leaves), " leaves; inside d ", 2 * rf, " mm at the floor, ",
         round(2 * (rf + (ZT - floor_t) * tf)), " mm at the rim; rim ", ZT, " mm; wall ", wall,
         ", floor ", floor_t, " mm; holds ", round(PI * pow(rf + (ZT - floor_t) * tf / 2, 2) * (ZT - floor_t) / 1000),
         " ml to the brim"));

// ---------------------------------------------------------------- output
if (part == "assembly") color("#3F8E43") render() saucer();
if (part == "body") saucer();
