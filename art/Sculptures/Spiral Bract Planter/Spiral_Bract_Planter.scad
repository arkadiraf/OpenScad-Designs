// END LEAVES

// ---------------------------------------------------------------- envelope
function R(z) = z <= 0 ? R0
              : z <= ZB ? R0 + (RB - R0) * (1 - cos(180 * z / ZB)) / 2
              : z <= ZT ? RT + (RB - RT) * (1 + cos(180 * (z - ZB) / (ZT - ZB))) / 2
              : RT;
function dR(z) = z <= 0 || z >= ZT ? 0
               : z <= ZB ? (RB - R0) * PI / (2 * ZB) * sin(180 * z / ZB)
               : -(RB - RT) * PI / (2 * (ZT - ZB)) * sin(180 * (z - ZB) / (ZT - ZB));
// near the rim the leaves' solid underside reaches into the wall, to 0.6 mm short of the inside,
// so the crown stands on the rim and the cavity cuts no leaf
function under_shift(z) = -(wall - 1.4) * ss(ZT - 15, ZT, z);
// inside of the pot: never narrows going up, so it has no ceiling
function Ri(z) = min(R(z) - wall, rim_in);

// ---------------------------------------------------------------- pot
module pot() rotate_extrude(convexity = 4) polygon(concat(
    [[0, 0]], [for (i = [0:60]) let(z = ZT * i / 60) [R(z), z]], [[0, ZT]]));
// The inside of the pot, carried on up past the rim; it stays 0.6 mm clear of the crown leaves.
module cavity() rotate_extrude(convexity = 4) polygon(concat(
    [[0, floor_t]], [for (i = [0:60]) let(z = floor_t + (ZT - floor_t) * i / 60) [Ri(z), z]],
    [[rim_in, ZT + 80], [0, ZT + 80]]));

module drain() if (drain_d > 0) {
    translate([0, 0, -1]) cylinder(d = drain_d, h = floor_t + 2, $fn = 48);
    // channels under the floor: short bridges, 5 mm wide
    for (k = [0:channels - 1]) rotate(90 + 360 * k / max(1, channels))
        translate([0, -channel_w / 2, -1]) cube([R0 + 30, channel_w, channel_d + 1]);
}

module planter() difference() {
    union() {
        pot();
        for (g = leaves) leaf(g);
    }
    cavity();
    translate([0, 0, -50]) cylinder(r = 200, h = 50);
    drain();
}

// ---------------------------------------------------------------- summary
echo(str("Spiral bract planter: ", len(leaves), " leaves; body d ", 2 * RB, " mm at the belly, rim ",
         ZT, " mm; opening d ", 2 * rim_in, " mm; wall ", wall, ", floor ", floor_t, " mm; drain ",
         drain_d > 0 ? str(drain_d, " mm, ", channels, " channels") : "none"));

// ---------------------------------------------------------------- output
if (part == "assembly") color("#3F8E43") render() planter();
if (part == "body") planter();
