// Spiral Bract Saucer - the drip tray for the Spiral Bract Planter, clad in the same leaves.
//
// A shallow tray whose wall flares out at 20 deg, covered in short bracts on the same golden-angle
// spiral as the planter (Spiral_Bract_leaf.scad: solid leaves with a 2.5 mm lip along their upper
// edges). The top leaves grow into a ring of petals that rise past the rim round the planter's foot.
// Leaves only dress the outside: floor and wall are one watertight shell.
//
// The fit: the planter's foot is 74.5 mm in radius at the bed and 82 mm 20 mm up, standing on the
// floor here at floor_t; the inside is rf = 79 mm at the floor and widens with the wall, so it
// clears the planter's leaves by 2.5 mm or more all the way up.
//
// The leaf table is generated by `Spiral_Bract_Planter_leaves.py layout --body saucer --write`
// and written between the BEGIN/END LEAVES markers below.

include <Spiral_Bract_leaf.scad>

/* [Output] */
part = "assembly"; // [assembly, body, none]
// Coarse leaf grids: for finding the shape
sketch = false;

/* [Tray] */
// keep in step with the S_ values in Spiral_Bract_Planter_leaves.py
rf = 79;            // inside radius at the floor, mm
wall = 3;           // wall under the leaves, mm
floor_t = 3;        // mm
ZT = 20;            // rim height, mm
flare = 20;         // wall flare from vertical, deg

/* [Leaves] */
// Leaf thickness at its free edges, mm
edge_t = 2.5;
// Veins on the leaves
texture_on = true;

/* [Hidden] */
texture = texture_on && !sketch;
GM = sketch ? 12 : texture ? 72 : 48;      // rows along a leaf (finer for the veins)
GN = sketch ? 8 : texture ? 40 : 28;       // columns across
$fn = sketch ? 72 : 240;
tf = tan(flare);
top = ZT + 40;

